# Compilation. /target/ reste listé : un clone sans makefile.local s'y compile,
# la redirection vers .tmp/ étant une contrainte de poste et non du projet.
/target/
*.pdb
*.rs.bk

# Répertoire de travail local : artefacts redirigés, binaires d'essai, sorties
# de contrôle comparées. Aucun exécutable ne sort d'ici.
/.tmp/
/makefile.local

# SDL3, décompressé à la main pour les hôtes de démonstration C et C++. Une
# dépendance système ne se versionne pas ; ici plutôt que sous /.tmp/ parce que
# `make clean` efface celui-ci, et qu'on ne retélécharge pas une archive à
# chaque nettoyage. `makefile.local` en porte le chemin.
/.sdl3/

# Hôtes — tout ce qui en sort est reconstruit
/hosts/web/pkg/
/hosts/c/*.exe
/hosts/c/*.obj
/hosts/c/*.lib
/hosts/c/*.exp
/hosts/android/.gradle/
/hosts/android/local.properties
/hosts/android/**/build/
/hosts/android/**/jniLibs/

# Systèmes de fichiers
.DS_Store
Thumbs.db
